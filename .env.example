# ===== Supabase =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-jwt
# Anon key — used by the dashboard for Supabase Realtime (postgres_changes) subscriptions
SUPABASE_ANON_KEY=

# ===== LLM Providers (router fallthrough order: Groq → Gemini → Cerebras) =====
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# ===== Free-tier Media Providers (replace Colab GPU servers) =====
# TTS — primary (10k chars/month free)
ELEVENLABS_API_KEY=
# Lipsync — primary (5 minutes/month free)
DID_API_KEY=
# Lipsync fallback / aggregator for many open-source models
FAL_API_KEY=
# Video assembly (free tier credits per month)
CREATOMATE_API_KEY=
# Stock video B-roll (free with attribution)
PEXELS_API_KEY=
# Royalty-free music + extra stock (free with attribution)
PIXABAY_API_KEY=
# Fallback image generator if Pollinations is rate-limited
HUGGINGFACE_API_KEY=
# Trend mining via YouTube Data API v3 (10k units/day free)
YOUTUBE_API_KEY=

# ===== Infra =====
REDIS_URL=redis://redis:6379
LOG_LEVEL=INFO
ENV=local

# ===== Worker =====
VIDEO_WORKER_ENABLED=true
VIDEO_QUEUE_NAME=viral:videos:queue

# ===== Cloudflare R2 (public hosting for finished videos & thumbnails) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=viral-videos
R2_PUBLIC_BASE_URL=

# ===== YouTube OAuth (for publishing — separate from YOUTUBE_API_KEY above) =====
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ===== TikTok Content Posting API v2 =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ===== Instagram Graph API (Business / Creator account) =====
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ===== Publishing rate limits (per-avatar+platform, Redis-enforced) =====
PUBLISH_MAX_PER_DAY=15
PUBLISH_MIN_GAP_SECONDS=1800

# ===== Per-avatar scheduler =====
SCHEDULER_TIMEZONE=Asia/Jerusalem

# ===== Web Push (VAPID) — generate with: python scripts/generate_vapid.py =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ===== Dashboard (Vite — must be set at build time) =====
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Same VAPID public key as above — the browser uses it to encrypt push payloads
VITE_VAPID_PUBLIC_KEY=
