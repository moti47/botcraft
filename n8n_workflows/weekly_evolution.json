{
  "name": "Weekly Evolution",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 23 * * 0" }
          ]
        }
      },
      "id": "4d0d4e1c-4444-4aaa-8bbb-000000000001",
      "name": "Sunday 23:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 320],
      "notes": "טריגר שבועי: יום ראשון בשעה 23:00. אומר ל-LLM לעדכן את ה-DNA של כל אווטאר."
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "avatars",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "is_active", "condition": "eq", "keyValue": "true" }
          ]
        }
      },
      "id": "4d0d4e1c-4444-4aaa-8bbb-000000000002",
      "name": "Supabase: active avatars",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [480, 320],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "Supabase main"
        }
      },
      "notes": "כל האווטארים הפעילים — לכל אחד יורץ Evolution Analysis נפרד."
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "4d0d4e1c-4444-4aaa-8bbb-000000000003",
      "name": "Loop avatars",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [720, 320],
      "notes": "אווטאר אחד בכל פעם — האנליזה של ה-LLM צריכה הקשר ייחודי."
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "posts",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "avatar_id", "condition": "eq", "keyValue": "={{ $json.id }}" },
            { "keyName": "posted_at", "condition": "gt", "keyValue": "={{ $now.minus({ days: 7 }).toISO() }}" }
          ]
        }
      },
      "id": "4d0d4e1c-4444-4aaa-8bbb-000000000004",
      "name": "Supabase: last 7d posts",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [960, 320],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "Supabase main"
        }
      },
      "notes": "ביצועי האווטאר בשבוע האחרון — קלט לאנליזה של ה-LLM."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://fastapi:8000/scripts/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"avatar_id\": \"{{ $('Loop avatars').item.json.id }}\",\n  \"topic\": \"EVOLUTION_ANALYSIS: analyze performance and suggest persona DNA updates. Posts from last 7 days: {{ JSON.stringify($json).slice(0, 4000) }}\"\n}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "4d0d4e1c-4444-4aaa-8bbb-000000000005",
      "name": "POST /scripts/generate (DNA patch)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 320],
      "notes": "ה-LLM מקבל topic מיוחד EVOLUTION_ANALYSIS ומחזיר JSON patch של persona_dna."
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// ממזג את ה-persona_dna הקיים עם ה-patch שה-LLM החזיר.\n// patch מצופה להיות JSON תחת script.dna_patch (או script.patch).\nconst avatar = $('Loop avatars').item.json;\nconst llmResp = $input.first()?.json || {};\nconst scriptObj = llmResp.script || {};\nconst patch = scriptObj.dna_patch || scriptObj.patch || {};\n\nconst current = avatar.persona_dna || {};\n\n// merge רדוד — מספיק לרוב השדות; להעמקה אפשר למזג רקורסיבית\nconst merged = { ...current, ...patch };\n// שמירת היסטוריה — נדחוף ל-evolution_log\nconst log = Array.isArray(current.evolution_log) ? current.evolution_log.slice() : [];\nlog.push({ at: new Date().toISOString(), patch });\nmerged.evolution_log = log.slice(-10);\n\nreturn [{ json: { id: avatar.id, persona_dna: merged } }];\n"
      },
      "id": "4d0d4e1c-4444-4aaa-8bbb-000000000006",
      "name": "Merge DNA patch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 320],
      "notes": "merge רדוד של ה-DNA הקיים עם ה-patch + שמירת evolution_log."
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "avatars",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $json.id }}" }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "persona_dna", "fieldValue": "={{ $json.persona_dna }}" }
          ]
        }
      },
      "id": "4d0d4e1c-4444-4aaa-8bbb-000000000007",
      "name": "Supabase: update DNA",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1680, 320],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "Supabase main"
        }
      },
      "notes": "כתיבה של ה-DNA המעודכן חזרה ל-avatars.persona_dna."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [{\n    \"title\": \"🧬 Weekly evolution complete\",\n    \"description\": \"Updated DNA for {{ $('Supabase: active avatars').all().length }} avatars (run: {{ $now.toISO() }}).\",\n    \"color\": 9442302\n  }]\n}",
        "options": {}
      },
      "id": "4d0d4e1c-4444-4aaa-8bbb-000000000008",
      "name": "Discord: evolution summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 320],
      "notes": "סיכום שבועי לדיסקורד — צבע סגול-בוטני (9442302) כתואם לאמוג׳י דנ\"א."
    }
  ],
  "connections": {
    "Sunday 23:00": {
      "main": [
        [ { "node": "Supabase: active avatars", "type": "main", "index": 0 } ]
      ]
    },
    "Supabase: active avatars": {
      "main": [
        [ { "node": "Loop avatars", "type": "main", "index": 0 } ]
      ]
    },
    "Loop avatars": {
      "main": [
        [ { "node": "Supabase: last 7d posts", "type": "main", "index": 0 } ],
        [ { "node": "Discord: evolution summary", "type": "main", "index": 0 } ]
      ]
    },
    "Supabase: last 7d posts": {
      "main": [
        [ { "node": "POST /scripts/generate (DNA patch)", "type": "main", "index": 0 } ]
      ]
    },
    "POST /scripts/generate (DNA patch)": {
      "main": [
        [ { "node": "Merge DNA patch", "type": "main", "index": 0 } ]
      ]
    },
    "Merge DNA patch": {
      "main": [
        [ { "node": "Supabase: update DNA", "type": "main", "index": 0 } ]
      ]
    },
    "Supabase: update DNA": {
      "main": [
        [ { "node": "Loop avatars", "type": "main", "index": 0 } ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jerusalem"
  },
  "tags": [
    { "name": "viral-empire" },
    { "name": "weekly" }
  ]
}
