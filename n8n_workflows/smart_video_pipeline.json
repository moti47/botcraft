{
  "name": "Smart Video Pipeline (no-Colab)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "produce-video",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "smartpipe-0001",
      "name": "Webhook: produce video",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 320],
      "notes": "POST /webhook/produce-video {\"avatar_id\": \"...\", \"topic\": \"...\" (optional — if missing we pull a fresh trend signal)}"
    },
    {
      "parameters": {
        "operation": "get",
        "tableId": "avatars",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.body.avatar_id }}"
            }
          ]
        }
      },
      "id": "smartpipe-0002",
      "name": "Supabase: avatar",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [480, 320],
      "credentials": {
        "supabaseApi": { "id": "supabase-main", "name": "Supabase main" }
      },
      "notes": "טוענים את ה-avatar (persona, brand_identity, music_genre, niche, language)."
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $node['Webhook: produce video'].json.body.topic || '' }}", "operation": "isEmpty" }
          ]
        }
      },
      "id": "smartpipe-0003",
      "name": "If: no topic supplied",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 320],
      "notes": "אם ה-payload לא כולל topic — נמשוך trend signal טרי. אחרת ישר לסקריפט."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/chat/tools/find_viral_topic",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"avatar_id\": \"{{ $node['Webhook: produce video'].json.body.avatar_id }}\"\n}",
        "options": { "timeout": 60000 }
      },
      "id": "smartpipe-0004",
      "name": "Trend engine: pick topic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 240],
      "notes": "קורא ל-FastAPI ש-מריץ את trend_engine.discover_for_avatar ומחזיר topic."
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "topic",
              "value": "={{ $node['Webhook: produce video'].json.body.topic || $node['Trend engine: pick topic'].json.topic }}"
            }
          ]
        },
        "options": {}
      },
      "id": "smartpipe-0005",
      "name": "Set: final topic",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/videos/produce",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"avatar_id\": \"{{ $node['Webhook: produce video'].json.body.avatar_id }}\",\n  \"topic\": \"{{ $node['Set: final topic'].json.topic }}\",\n  \"voice\": \"{{ $node['Webhook: produce video'].json.body.voice || 'auto' }}\",\n  \"auto_post\": {{ $node['Webhook: produce video'].json.body.auto_post || false }}\n}",
        "options": { "timeout": 30000 }
      },
      "id": "smartpipe-0006",
      "name": "FastAPI: kick off pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 320],
      "notes": "מתחיל את כל הצינור: script→TTS→lipsync→music→assembly. החזרה מיידית עם video_id."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"video_id\": \"{{ $node['FastAPI: kick off pipeline'].json.video_id }}\", \"status\": \"queued\", \"topic\": \"{{ $node['Set: final topic'].json.topic }}\" }"
      },
      "id": "smartpipe-0007",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1680, 320]
    }
  ],
  "connections": {
    "Webhook: produce video": {
      "main": [[{ "node": "Supabase: avatar", "type": "main", "index": 0 }]]
    },
    "Supabase: avatar": {
      "main": [[{ "node": "If: no topic supplied", "type": "main", "index": 0 }]]
    },
    "If: no topic supplied": {
      "main": [
        [{ "node": "Trend engine: pick topic", "type": "main", "index": 0 }],
        [{ "node": "Set: final topic", "type": "main", "index": 0 }]
      ]
    },
    "Trend engine: pick topic": {
      "main": [[{ "node": "Set: final topic", "type": "main", "index": 0 }]]
    },
    "Set: final topic": {
      "main": [[{ "node": "FastAPI: kick off pipeline", "type": "main", "index": 0 }]]
    },
    "FastAPI: kick off pipeline": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jerusalem"
  },
  "tags": [{ "name": "smart-pipeline" }]
}
