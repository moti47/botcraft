{
  "name": "Daily Content Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000001",
      "name": "Daily 09:00 (Asia/Jerusalem)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 320],
      "notes": "Schedule Trigger — every day at 09:00 (Asia/Jerusalem). הטריגר היומי של pipeline התוכן."
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "avatars",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "is_active",
              "condition": "eq",
              "keyValue": "true"
            }
          ]
        }
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000002",
      "name": "Supabase: list active avatars",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [480, 320],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "Supabase main"
        }
      },
      "notes": "שולף את כל האווטארים הפעילים מסופבייס. טבלת avatars משתמשת ב-is_active (לא status)."
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000003",
      "name": "Loop over avatars",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [720, 320],
      "notes": "מעבד אווטאר אחד בכל פעם — כל הצינור (script, queue, publish) חוזר לכאן."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://fastapi:8000/scripts/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"avatar_id\": \"{{ $json.id }}\",\n  \"topic\": \"auto from trends\"\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 120000
        }
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000004",
      "name": "POST /scripts/generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 220],
      "notes": "יוצר סקריפט אוטומטי לפי trends. ה-API פונה ל-llm_router (Groq/Gemini/Cerebras)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://fastapi:8000/videos/queue",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"avatar_id\": \"{{ $('Loop over avatars').item.json.id }}\",\n  \"script_id\": \"{{ $json.id }}\",\n  \"voice_ref_filename\": \"{{ $('Loop over avatars').item.json.persona_dna?.voice_ref_filename || 'nova.wav' }}\"\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000005",
      "name": "POST /videos/queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 220],
      "notes": "מציב את עבודת הווידאו ב-Redis. ה-worker יורד עליה כשיתפנה."
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "hours"
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000006",
      "name": "Wait 2h (render time)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1440, 220],
      "notes": "מדמה זמן רנדור. בפרודקשן עדיף polling על /videos/{job_id} עד status=ready."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://fastapi:8000/posts/publish",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"video_id\": \"{{ $json.job_id }}\",\n  \"caption\": \"{{ $('Loop over avatars').item.json.niche }} — auto from trends\",\n  \"hashtags\": [\"viral\", \"shorts\", \"ai\"]\n}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000007",
      "name": "POST /posts/publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 220],
      "notes": "מפרסם לכל הפלטפורמות שמחוברות לאווטאר (platform_tokens). שדה platforms לא נדרש."
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "content_runs",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "avatar_id", "fieldValue": "={{ $('Loop over avatars').item.json.id }}" },
            { "fieldId": "video_id", "fieldValue": "={{ $('POST /videos/queue').item.json.job_id }}" },
            { "fieldId": "result", "fieldValue": "={{ JSON.stringify($json.results) }}" },
            { "fieldId": "ran_at", "fieldValue": "={{ $now.toISO() }}" }
          ]
        }
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000008",
      "name": "Supabase: insert content_runs",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1920, 220],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "Supabase main"
        }
      },
      "notes": "מתעד את תוצאת הריצה. הטבלה content_runs היא טבלת אוודיט; ייתכן שתצטרך ליצור אותה."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [{\n    \"title\": \"📅 Daily content pipeline complete\",\n    \"description\": \"Avatar `{{ $('Loop over avatars').item.json.handle || $('Loop over avatars').item.json.id }}` finished.\\nResults: ```{{ JSON.stringify($('POST /posts/publish').item.json.results).slice(0,1000) }}```\",\n    \"color\": 3447003\n  }]\n}",
        "options": {}
      },
      "id": "1a0d4e1c-1111-4aaa-8bbb-000000000009",
      "name": "Discord: daily summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, 220],
      "notes": "סיכום יומי לדיסקורד. ה-webhook נטען מ-env DISCORD_WEBHOOK_URL."
    }
  ],
  "connections": {
    "Daily 09:00 (Asia/Jerusalem)": {
      "main": [
        [
          { "node": "Supabase: list active avatars", "type": "main", "index": 0 }
        ]
      ]
    },
    "Supabase: list active avatars": {
      "main": [
        [
          { "node": "Loop over avatars", "type": "main", "index": 0 }
        ]
      ]
    },
    "Loop over avatars": {
      "main": [
        [
          { "node": "POST /scripts/generate", "type": "main", "index": 0 }
        ]
      ]
    },
    "POST /scripts/generate": {
      "main": [
        [
          { "node": "POST /videos/queue", "type": "main", "index": 0 }
        ]
      ]
    },
    "POST /videos/queue": {
      "main": [
        [
          { "node": "Wait 2h (render time)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Wait 2h (render time)": {
      "main": [
        [
          { "node": "POST /posts/publish", "type": "main", "index": 0 }
        ]
      ]
    },
    "POST /posts/publish": {
      "main": [
        [
          { "node": "Supabase: insert content_runs", "type": "main", "index": 0 }
        ]
      ]
    },
    "Supabase: insert content_runs": {
      "main": [
        [
          { "node": "Discord: daily summary", "type": "main", "index": 0 }
        ]
      ]
    },
    "Discord: daily summary": {
      "main": [
        [
          { "node": "Loop over avatars", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jerusalem"
  },
  "tags": [
    { "name": "viral-empire" },
    { "name": "daily" }
  ]
}
