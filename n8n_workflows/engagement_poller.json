{
  "name": "Engagement Poller",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 3 }
          ]
        }
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000001",
      "name": "Every 3 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 320],
      "notes": "סורק את כל הפוסטים מ-7 הימים האחרונים פעם ב-3 שעות."
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "posts",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "status", "condition": "eq", "keyValue": "posted" },
            { "keyName": "posted_at", "condition": "gt", "keyValue": "={{ $now.minus({ days: 7 }).toISO() }}" }
          ]
        }
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000002",
      "name": "Supabase: posts (7d)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [480, 320],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "Supabase main"
        }
      },
      "notes": "שולף פוסטים שפורסמו ב-7 הימים האחרונים. רק הם רלוונטיים למדידה."
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000003",
      "name": "Loop posts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [720, 320],
      "notes": "מטפל בפוסט אחד בכל פעם — נדרש כדי לבחור endpoint לפי platform."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "rightValue": "youtube",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "outputKey": "youtube"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose" },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.platform }}",
                    "rightValue": "instagram",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "outputKey": "instagram"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000004",
      "name": "Switch by platform",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [960, 320],
      "notes": "מפצל את הפוסטים ל-3 מסלולים: youtube, instagram, אחר (TikTok נופל ל-fallback)."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/youtube/v3/videos?part=statistics&id={{ $json.platform_post_id }}&key={{ $env.YOUTUBE_API_KEY }}",
        "options": {}
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000005",
      "name": "YouTube: GET stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 200],
      "notes": "מושך views/likes/comments מ-YouTube Data API. דורש YOUTUBE_API_KEY ב-env."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.platform_post_id }}/insights?metric=reach,likes,comments,shares&access_token={{ $env.INSTAGRAM_ACCESS_TOKEN }}",
        "options": {}
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000006",
      "name": "Instagram: GET insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 360],
      "notes": "Insights API של Instagram Graph. הטוקן per-avatar אמור לבוא מ-platform_tokens; כאן רק fallback."
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// מנרמל את התשובה לפי הפלטפורמה ומחשב viral_score.\nconst input = $input.first()?.json || {};\nconst post = $('Loop posts').item.json;\nconst platform = post.platform;\n\nlet views = 0, likes = 0, comments = 0, shares = 0;\n\nif (platform === 'youtube') {\n  const stats = (input.items?.[0]?.statistics) || {};\n  views = parseInt(stats.viewCount || 0, 10);\n  likes = parseInt(stats.likeCount || 0, 10);\n  comments = parseInt(stats.commentCount || 0, 10);\n} else if (platform === 'instagram') {\n  // Graph API מחזיר data: [{name, values:[{value}]}]\n  const data = input.data || [];\n  const pick = (n) => parseInt((data.find(d => d.name === n)?.values?.[0]?.value) || 0, 10);\n  views = pick('reach') || pick('impressions');\n  likes = pick('likes');\n  comments = pick('comments');\n  shares = pick('shares');\n} else {\n  // TikTok / אחרים — אין endpoint ציבורי. נחזיר 0 וניתן להמשיך.\n}\n\n// score = (likes*3 + comments*5 + shares*10) / max(views, 1)\nconst score = (likes * 3 + comments * 5 + shares * 10) / Math.max(views, 1);\nconst metrics = { views, likes, comments, shares, viral_score: Math.round(score * 1000) / 1000 };\n\nreturn [{ json: { post_id: post.id, platform, metrics, viral: score > 0.15 } }];\n"
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000007",
      "name": "Compute viral_score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 320],
      "notes": "score = (likes*3 + comments*5 + shares*10) / views. סף לויראליות: 0.15."
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "posts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $json.post_id }}" }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "metrics", "fieldValue": "={{ $json.metrics }}" }
          ]
        }
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000008",
      "name": "Supabase: update metrics",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1680, 320],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-main",
          "name": "Supabase main"
        }
      },
      "notes": "מעדכן posts.metrics עם הנתונים הטריים."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.metrics.viral_score }}",
              "rightValue": 0.15,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        },
        "options": {}
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000009",
      "name": "If viral_score > 0.15",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1920, 320],
      "notes": "מסנן רק פוסטים ויראליים — אלו שעוברים את 15%."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [{\n    \"title\": \"🚀 Viral video detected\",\n    \"description\": \"Post `{{ $json.post_id }}` on **{{ $json.platform }}** — score {{ $json.metrics.viral_score }}\\nviews: {{ $json.metrics.views }} · likes: {{ $json.metrics.likes }} · comments: {{ $json.metrics.comments }}\",\n    \"color\": 5763719\n  }]\n}",
        "options": {}
      },
      "id": "3c0d4e1c-3333-4aaa-8bbb-000000000010",
      "name": "Discord: viral alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2160, 320],
      "notes": "התראה לדיסקורד עם הצבע ירוק (5763719) — סימן חיובי, וידאו פיצוץ."
    }
  ],
  "connections": {
    "Every 3 hours": {
      "main": [
        [ { "node": "Supabase: posts (7d)", "type": "main", "index": 0 } ]
      ]
    },
    "Supabase: posts (7d)": {
      "main": [
        [ { "node": "Loop posts", "type": "main", "index": 0 } ]
      ]
    },
    "Loop posts": {
      "main": [
        [ { "node": "Switch by platform", "type": "main", "index": 0 } ]
      ]
    },
    "Switch by platform": {
      "main": [
        [ { "node": "YouTube: GET stats", "type": "main", "index": 0 } ],
        [ { "node": "Instagram: GET insights", "type": "main", "index": 0 } ],
        [ { "node": "Compute viral_score", "type": "main", "index": 0 } ]
      ]
    },
    "YouTube: GET stats": {
      "main": [
        [ { "node": "Compute viral_score", "type": "main", "index": 0 } ]
      ]
    },
    "Instagram: GET insights": {
      "main": [
        [ { "node": "Compute viral_score", "type": "main", "index": 0 } ]
      ]
    },
    "Compute viral_score": {
      "main": [
        [ { "node": "Supabase: update metrics", "type": "main", "index": 0 } ]
      ]
    },
    "Supabase: update metrics": {
      "main": [
        [ { "node": "If viral_score > 0.15", "type": "main", "index": 0 } ]
      ]
    },
    "If viral_score > 0.15": {
      "main": [
        [ { "node": "Discord: viral alert", "type": "main", "index": 0 } ],
        [ { "node": "Loop posts", "type": "main", "index": 0 } ]
      ]
    },
    "Discord: viral alert": {
      "main": [
        [ { "node": "Loop posts", "type": "main", "index": 0 } ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jerusalem"
  },
  "tags": [
    { "name": "viral-empire" },
    { "name": "metrics" }
  ]
}
