{
  "name": "Nightly Learning (analyze metrics → facts)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 3 * * *" }
          ]
        }
      },
      "id": "learn-0001",
      "name": "Daily 03:00 (Asia/Jerusalem)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 320],
      "notes": "טריגר יומי בשעה 03:00. שעת השפל של ה-API rate limits."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://fastapi:8000/insights/learn-all",
        "sendBody": false,
        "options": { "timeout": 1800000 }
      },
      "id": "learn-0002",
      "name": "FastAPI: learn-all",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 320],
      "notes": "מריץ learning_system.analyze_all_active — לכל avatar עם >=3 וידאו, מסיק facts ושומר ב-learning_facts."
    }
  ],
  "connections": {
    "Daily 03:00 (Asia/Jerusalem)": {
      "main": [[{ "node": "FastAPI: learn-all", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jerusalem"
  },
  "tags": [{ "name": "learning" }]
}
